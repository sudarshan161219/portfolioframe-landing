---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, faq, cover, product } = post.data;
const CTAS = {
  'portfolio-frame': {
    heading: 'Make your next screenshot look good in seconds.',
    text: 'Portfolio Frame is free, runs locally, and needs no account.',
    label: 'Add Portfolio Frame to Chrome, free',
    url: 'https://chromewebstore.google.com/detail/kgpdfalcolcdidglbdnfnelgihlocmkf?utm_source=blog_post',
  },
  cutout: {
    heading: 'Remove backgrounds without uploading anything.',
    text: 'Cutout runs entirely on your device. Free, no account, no watermark, works offline.',
    label: 'Add Cutout to Chrome, free',
    url: 'https://chromewebstore.google.com/detail/bbabbmnpeiapnfikblfhdjkbodpgiolb?utm_source=blog_post',
  },
};
const cta = CTAS[product];
const productLabel = { 'portfolio-frame': 'Portfolio Frame', cutout: 'Cutout' }[product];
const readMins = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 230));
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = cover ? new URL(cover, Astro.site).href : 'https://portfolioframe.com/og-image.png';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    image,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Person', name: 'Sud', url: 'https://x.com/buildwithSud', sameAs: ['https://x.com/buildwithSud', 'https://buildwithsud.com'] },
    publisher: { '@type': 'Organization', name: 'Portfolio Frame', url: 'https://portfolioframe.com' },
  },
];
if (faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Layout title={`${title} | Portfolio Frame`} description={description} image={image} type="article" schema={schema}>
  <article class="post">
    <header class="post-head">
      <p class="eyebrow"><a href="/blog/">Blog</a> <span aria-hidden="true">/</span> {productLabel}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="meta-row">
        <p class="meta">By <a href="https://x.com/buildwithSud" rel="author noopener" target="_blank">Sud</a> · <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time> · {readMins} min read</p>
        <button class="slides-btn" type="button" data-open-slides hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
          View as slides
        </button>
      </div>
    </header>

    <div class="post-body prose" id="post-body">
      <Content />
    </div>

    {faq.length > 0 && (
      <section class="faq" data-deck-faq>
        <p class="eyebrow">FAQ</p>
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details>
              <summary><span>{f.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <aside class="try" data-deck-cta>
      <p class="eyebrow">Free Chrome extension</p>
      <strong>{cta.heading}</strong>
      <p>{cta.text}</p>
      <a class="cta" href={cta.url} rel="noopener">{cta.label}</a>
    </aside>
  </article>
</Layout>

<script>
  // Slides view: same content as the article, shown as a full-screen deck.
  // The article HTML is untouched, so search engines still read the full post.
  const body = document.getElementById('post-body');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-open-slides]');

  if (body && openBtn && body.querySelector('h2')) {
    openBtn.hidden = false;
    const title = document.querySelector('article h1')?.textContent ?? '';
    const meta = document.querySelector('article .meta');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let deck: HTMLElement | null = null;
    let slides: HTMLElement[] = [];
    let idx = 0;
    let lastFocus: Element | null = null;

    // Clone nodes without duplicate ids; keep the id as data-sid for #anchor jumps.
    const cloneClean = (node: Element) => {
      const c = node.cloneNode(true) as Element;
      [c, ...Array.from(c.querySelectorAll('[id]'))].forEach((el) => {
        if (el.id) { el.setAttribute('data-sid', el.id); el.removeAttribute('id'); }
      });
      return c;
    };

    const makeSlide = (nodes: Element[], variant = '') => {
      const s = document.createElement('section');
      s.className = 'deck-slide' + (variant ? ' deck-slide--' + variant : '');
      s.setAttribute('role', 'group');
      s.setAttribute('aria-roledescription', 'slide');
      const inner = document.createElement('div');
      inner.className = 'deck-inner';
      nodes.forEach((n) => inner.appendChild(n));
      s.appendChild(inner);
      return s;
    };

    const build = () => {
      // Group the article by H2: [intro, section1, section2, ...]
      const groups: Element[][] = [[]];
      Array.from(body.children).forEach((n) => {
        if (n.tagName === 'H2') groups.push([]);
        groups[groups.length - 1].push(n);
      });

      const h = document.createElement('h1');
      h.textContent = title;
      const titleNodes: Element[] = [h];
      if (meta) titleNodes.push(cloneClean(meta));
      const intro = groups.shift() ?? [];
      const out: HTMLElement[] = [makeSlide(titleNodes, 'title')];
      if (intro.length) out.push(makeSlide(intro.map(cloneClean)));
      groups.forEach((g) => out.push(makeSlide(g.map(cloneClean))));

      const faq = document.querySelector('[data-deck-faq]');
      if (faq) out.push(makeSlide([cloneClean(faq)]));
      const cta = document.querySelector('[data-deck-cta]');
      if (cta) out.push(makeSlide([cloneClean(cta)], 'cta'));

      const el = document.createElement('div');
      el.className = 'deck' + (reduceMotion ? ' deck--still' : '');
      el.setAttribute('role', 'dialog');
      el.setAttribute('aria-modal', 'true');
      el.setAttribute('aria-label', 'Slides: ' + title);
      el.innerHTML = `
        <div class="deck-progress" aria-hidden="true"><span></span></div>
        <div class="deck-stage"></div>
        <div class="deck-bar">
          <button type="button" class="deck-btn" data-prev aria-label="Previous slide">&#8592;</button>
          <span class="deck-count" aria-live="polite"></span>
          <button type="button" class="deck-btn" data-next aria-label="Next slide">&#8594;</button>
          <button type="button" class="deck-btn deck-close" data-close aria-label="Close slides (Esc)">&#10005;</button>
        </div>`;
      const stage = el.querySelector('.deck-stage')!;
      out.forEach((s, i) => { s.setAttribute('aria-label', `${i + 1} of ${out.length}`); stage.appendChild(s); });

      el.querySelector('[data-prev]')!.addEventListener('click', () => go(idx - 1));
      el.querySelector('[data-next]')!.addEventListener('click', () => go(idx + 1));
      el.querySelector('[data-close]')!.addEventListener('click', close);

      // "In this guide" style #anchor links jump to the matching slide
      el.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a[href^="#"]');
        if (!a) return;
        const id = decodeURIComponent(a.getAttribute('href')!.slice(1));
        const target = out.findIndex((s) => s.querySelector(`[data-sid="${CSS.escape(id)}"]`));
        if (target >= 0) { e.preventDefault(); go(target); }
      });

      // Swipe
      let x0 = 0, y0 = 0;
      el.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      el.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) go(idx + (dx < 0 ? 1 : -1));
      });

      document.body.appendChild(el);
      slides = out;
      return el;
    };

    const render = () => {
      if (!deck) return;
      slides.forEach((s, i) => {
        const on = i === idx;
        s.classList.toggle('is-active', on);
        s.classList.toggle('is-before', i < idx);
        s.toggleAttribute('inert', !on);
        s.setAttribute('aria-hidden', String(!on));
        if (on) s.scrollTop = 0;
      });
      deck.querySelector<HTMLElement>('.deck-count')!.textContent = `${idx + 1} / ${slides.length}`;
      deck.querySelector<HTMLElement>('.deck-progress span')!.style.width = `${((idx + 1) / slides.length) * 100}%`;
      (deck.querySelector('[data-prev]') as HTMLButtonElement).disabled = idx === 0;
      (deck.querySelector('[data-next]') as HTMLButtonElement).disabled = idx === slides.length - 1;
      history.replaceState(null, '', '#slides-' + (idx + 1));
    };

    const go = (i: number) => { idx = Math.max(0, Math.min(slides.length - 1, i)); render(); };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (['ArrowRight', 'PageDown'].includes(e.key) || (e.key === ' ' && !e.shiftKey)) { e.preventDefault(); go(idx + 1); }
      else if (['ArrowLeft', 'PageUp'].includes(e.key) || (e.key === ' ' && e.shiftKey)) { e.preventDefault(); go(idx - 1); }
      else if (e.key === 'Home') { e.preventDefault(); go(0); }
      else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    };

    const open = (start = 0) => {
      lastFocus = document.activeElement;
      deck = deck ?? build();
      deck.hidden = false;
      document.documentElement.classList.add('deck-open');
      document.addEventListener('keydown', onKey);
      go(start);
      deck.querySelector<HTMLElement>('[data-next]')!.focus();
    };

    function close() {
      if (!deck) return;
      deck.hidden = true;
      document.documentElement.classList.remove('deck-open');
      document.removeEventListener('keydown', onKey);
      history.replaceState(null, '', location.pathname + location.search);
      (lastFocus as HTMLElement | null)?.focus?.();
    }

    openBtn.addEventListener('click', () => open(0));

    // Deep link: /blog/post/#slides or #slides-4
    const fromHash = () => {
      const m = location.hash.match(/^#slides(?:-(\d+))?$/);
      if (m) open(m[1] ? Number(m[1]) - 1 : 0);
    };
    fromHash();
    window.addEventListener('hashchange', () => { if (!deck || deck.hidden) fromHash(); });
  }
</script>

<style>
  .post { max-width: calc(var(--measure) + 2 * var(--edge)); margin: 0 auto; padding: clamp(40px, 7vw, 72px) var(--edge) 0; }
  .post-head { margin-bottom: 40px; padding-bottom: 28px; border-bottom: 1px solid var(--hairline); }
  .post-head h1 { font-family: var(--font-display); font-weight: 480; font-size: clamp(2rem, 4.6vw, 3.2rem); line-height: 1.08; letter-spacing: -.01em; margin: 0 0 16px; }
  .dek { font-size: 1.1rem; line-height: 1.6; color: var(--text-muted); margin: 0 0 24px; }
  .meta-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .meta { font-family: var(--font-mono); font-size: .78rem; color: var(--text-faint); margin: 0; }
  .meta a { color: var(--text-muted); text-decoration: none; }
  .meta a:hover { color: var(--mint); }
  .slides-btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: .74rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-primary); background: transparent; border: 1px solid var(--hairline-strong); border-radius: var(--radius-sm); padding: 8px 12px; cursor: pointer; transition: border-color .15s ease, color .15s ease; }
  .slides-btn[hidden] { display: none; }
  .slides-btn:hover { border-color: var(--mint); color: var(--mint); }

  /* FAQ: same look as the landing page FAQ */
  .faq { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--hairline); }
  .faq h2 { font-family: var(--font-display); font-weight: 480; font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 0 0 24px; }
  .faq-list { border-top: 1px solid var(--hairline); }
  .faq details { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; padding: 20px 4px; font-weight: 600; font-size: 1rem; color: var(--text-primary); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon { flex: none; font-family: var(--font-mono); font-size: 1.1rem; color: var(--mint); transition: transform .15s ease; }
  .faq details[open] .faq-icon { transform: rotate(45deg); }
  .faq details p { margin: 0 0 20px; padding: 0 4px; font-size: .93rem; line-height: 1.65; color: var(--text-muted); }

  /* Closing call to action */
  .try { margin-top: 56px; padding: clamp(24px, 4vw, 36px); border-radius: var(--radius-lg); background: var(--bg-elev); border: 1px solid var(--hairline); }
  .try strong { display: block; font-family: var(--font-display); font-weight: 480; font-size: clamp(1.4rem, 3vw, 1.8rem); line-height: 1.2; margin-bottom: 10px; }
  .try p:not(.eyebrow) { margin: 0 0 20px; color: var(--text-muted); line-height: 1.6; }
  .try .cta { display: inline-block; font-family: var(--font-mono); font-size: .8rem; letter-spacing: .03em; font-weight: 600; text-decoration: none; color: var(--void); background: var(--mint); padding: 12px 18px; border-radius: var(--radius-sm); transition: background .15s ease, transform .15s ease; }
  .try .cta:hover { background: var(--sage); transform: translateY(-1px); }
</style>

<style is:global>
  /* Article typography (global because markdown HTML has no scoped classes) */
  .prose { font-size: 1.05rem; line-height: 1.75; color: var(--text-muted); }
  .prose > * + * { margin-top: 1.15em; }
  .prose p, .prose ul, .prose ol { margin-bottom: 0; }
  .prose strong { color: var(--text-primary); font-weight: 600; }
  .prose h2 { font-family: var(--font-display); font-weight: 480; font-size: clamp(1.5rem, 3vw, 1.95rem); line-height: 1.2; color: var(--text-primary); margin: 2.2em 0 0; padding-top: 1.1em; border-top: 1px solid var(--hairline); scroll-margin-top: 90px; }
  .prose h3 { font-family: var(--font-body); font-weight: 600; font-size: 1.15rem; color: var(--text-primary); margin: 1.8em 0 0; scroll-margin-top: 90px; }
  .prose a { color: var(--mint); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose a:hover { color: var(--text-primary); }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose li { margin: .45em 0; }
  .prose li::marker { color: var(--sage); }
  .prose img { display: block; border-radius: var(--radius-md); border: 1px solid var(--hairline); margin: 1.8em auto; }
  .prose blockquote { margin: 1.6em 0; padding: 4px 0 4px 18px; border-left: 2px solid var(--mint); color: var(--text-primary); }
  .prose code { font-family: var(--font-mono); font-size: .86em; background: var(--bg-elev); border: 1px solid var(--hairline); border-radius: 4px; padding: .1em .4em; color: var(--text-primary); }
  .prose pre { background: var(--bg-elev-2); border: 1px solid var(--hairline); border-radius: var(--radius-md); padding: 18px 20px; overflow-x: auto; font-size: .88rem; line-height: 1.6; }
  .prose pre code { background: none; border: 0; padding: 0; font-size: inherit; }
  .prose table { width: 100%; border-collapse: collapse; display: block; overflow-x: auto; font-size: .92rem; }
  .prose th, .prose td { border-bottom: 1px solid var(--hairline); padding: 10px 14px 10px 0; text-align: left; vertical-align: top; }
  .prose th { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-faint); font-weight: 500; }
  .prose td { color: var(--text-muted); }
  .prose hr { border: 0; border-top: 1px solid var(--hairline); margin: 2.4em 0; }

  /* ---------- Slides deck (elements created by JS) ---------- */
  html.deck-open { overflow: hidden; }
  .deck { position: fixed; inset: 0; z-index: 1000; background: var(--void); color: var(--text-primary); display: flex; flex-direction: column; }
  .deck[hidden] { display: none; }
  .deck-progress { height: 3px; background: var(--hairline); flex: none; }
  .deck-progress span { display: block; height: 100%; width: 0; background: var(--mint); transition: width .3s ease; }
  .deck-stage { position: relative; flex: 1; overflow: hidden; }
  .deck-slide { position: absolute; inset: 0; display: flex; overflow-y: auto; padding: clamp(24px, 6vh, 64px) 16px; opacity: 0; transform: translateX(40px); transition: opacity .3s ease, transform .3s ease; pointer-events: none; }
  .deck-slide.is-before { transform: translateX(-40px); }
  .deck-slide.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .deck--still .deck-slide, .deck--still .deck-progress span { transition: none; }
  .deck-inner { margin: auto; width: 100%; max-width: 860px; font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; color: var(--text-muted); }
  .deck-inner strong { color: var(--text-primary); }
  .deck-inner a { color: var(--mint); }
  .deck-inner h1 { font-family: var(--font-display); font-weight: 480; font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1.08; color: var(--text-primary); margin: 0 0 20px; }
  .deck-inner h2 { font-family: var(--font-display); font-weight: 480; font-size: clamp(1.7rem, 4.2vw, 2.7rem); line-height: 1.15; color: var(--text-primary); margin: 0 0 .6em; padding-top: 14px; border-top: 2px solid var(--mint); display: inline-block; }
  .deck-inner h3 { font-size: clamp(1.1rem, 2.4vw, 1.45rem); color: var(--text-primary); margin: 1.2em 0 .4em; }
  .deck-inner img { max-height: 55vh; width: auto; display: block; margin: 16px auto; border-radius: var(--radius-md); border: 1px solid var(--hairline); }
  .deck-inner ul, .deck-inner ol { padding-left: 1.2em; }
  .deck-inner li { margin: .35em 0; }
  .deck-inner code { font-family: var(--font-mono); font-size: .85em; background: var(--bg-elev); padding: .1em .4em; border-radius: 4px; color: var(--text-primary); }
  .deck-inner table { border-collapse: collapse; font-size: .9em; }
  .deck-inner th, .deck-inner td { border-bottom: 1px solid var(--hairline); padding: 8px 14px 8px 0; text-align: left; }
  .deck-inner .faq { margin: 0; padding: 0; border: 0; }
  .deck-inner .faq details p { margin: 0 0 16px; }
  .deck-slide--title { background: var(--bg-elev); }
  .deck-slide--title .meta { font-family: var(--font-mono); font-size: .85rem; color: var(--text-faint); }
  .deck-slide--title h1::after { content: ''; display: block; width: 64px; height: 3px; background: var(--mint); margin-top: 24px; border-radius: 2px; }
  .deck-slide--cta { background: var(--bg-elev); }
  .deck-slide--cta .try { margin: 0; padding: 0; background: none; border: 0; }
  .deck-slide--cta .try strong { font-size: clamp(1.8rem, 4.5vw, 3rem); margin-bottom: 14px; }
  .deck-bar { position: relative; flex: none; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid var(--hairline); background: var(--bg-elev-2); }
  .deck-btn { font-family: var(--font-mono); font-size: 1rem; min-width: 44px; height: 44px; border-radius: var(--radius-sm); border: 1px solid var(--hairline-strong); background: transparent; color: var(--text-primary); cursor: pointer; }
  .deck-btn:hover:not(:disabled) { border-color: var(--mint); color: var(--mint); }
  .deck-btn:disabled { opacity: .3; cursor: default; }
  .deck-close { position: absolute; right: 16px; }
  .deck-count { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: .82rem; min-width: 64px; text-align: center; color: var(--text-faint); }
</style>
