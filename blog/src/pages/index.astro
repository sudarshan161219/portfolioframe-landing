---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const productLabel = { 'portfolio-frame': 'Portfolio Frame', cutout: 'Cutout' } as const;
---
<Layout
  title="Blog | Portfolio Frame"
  description="Guides on making beautiful screenshots, code images, device mockups and background-free images for developers and indie makers."
>
  <section class="blog-hero">
    <p class="eyebrow">Blog</p>
    <h1>Guides for better screenshots and visuals</h1>
    <p class="lede">Practical guides on screenshots, code images, mockups and background removal, from the maker of Portfolio Frame and Cutout.</p>
  </section>

  <section class="post-list">
    {posts.length === 0 && <p class="empty">First posts are on the way.</p>}
    <ul>
      {posts.map((post) => (
        <li>
          <a class="post-card" href={`/blog/${post.id}/`}>
            <span class="post-meta">
              <span>{productLabel[post.data.product]}</span>
              <span aria-hidden="true">·</span>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="read">Read guide →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .blog-hero { max-width: var(--container); margin: 0 auto; padding: clamp(48px, 8vw, 84px) var(--edge) clamp(28px, 4vw, 40px); }
  h1 { font-family: var(--font-display); font-weight: 480; font-size: clamp(2.1rem, 4.8vw, 3.4rem); line-height: 1.08; margin: 0 0 16px; max-width: 18ch; }
  .lede { max-width: 60ch; font-size: 1.05rem; line-height: 1.65; color: var(--text-muted); margin: 0; }
  .post-list { max-width: var(--container); margin: 0 auto; padding: 0 var(--edge); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .post-card { display: flex; flex-direction: column; height: 100%; text-decoration: none; background: var(--bg-elev); border: 1px solid var(--hairline); border-radius: var(--radius-md); padding: 24px; transition: border-color .15s ease, transform .15s ease; }
  .post-card:hover { border-color: var(--hairline-strong); transform: translateY(-2px); }
  .post-meta { display: flex; gap: 8px; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 14px; }
  .post-card h2 { font-family: var(--font-display); font-weight: 480; font-size: 1.35rem; line-height: 1.25; margin: 0 0 10px; color: var(--text-primary); }
  .post-card p { margin: 0 0 18px; font-size: .92rem; line-height: 1.6; color: var(--text-muted); flex: 1; }
  .read { font-family: var(--font-mono); font-size: .76rem; letter-spacing: .03em; color: var(--mint); }
  .empty { color: var(--text-muted); }
</style>
