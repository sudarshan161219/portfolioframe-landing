---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: object | object[];
}
const { title, description, image = 'https://portfolioframe.com/og-image.png', type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CWS = 'https://chromewebstore.google.com/detail/kgpdfalcolcdidglbdnfnelgihlocmkf?utm_source=blog';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/blog/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Portfolio Frame</a>
      <nav>
        <a href="/blog/">Blog</a>
        <a class="cta" href={CWS} rel="noopener">Add to Chrome, free</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>Portfolio Frame turns screenshots, code and tweets into polished images. Everything runs locally in your browser.</p>
      <p><a href="/">Home</a> · <a href="/privacy">Privacy</a> · <a href={CWS} rel="noopener">Chrome Web Store</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cream: #FFF6DE; --paper: #FBF6E9; --ink: #1B211A; --ink-deep: #091413;
    --red: #F93827; --green: #5DB996; --teal: #8BDFDD; --muted: #4a5348; --line: #e7dcc0;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 18px/1.7 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--ink); text-decoration-color: var(--red); text-underline-offset: 3px; }
  a:hover { color: var(--red); }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px clamp(16px, 4vw, 40px); border-bottom: 1px solid var(--line); background: var(--cream); flex-wrap: wrap; }
  .brand { font-weight: 800; text-decoration: none; font-size: 1.05rem; }
  .site-header nav { display: flex; gap: 18px; align-items: center; font-size: .95rem; }
  .site-header nav a { text-decoration: none; }
  .cta { background: var(--ink); color: var(--cream) !important; padding: 8px 14px; border-radius: 8px; font-weight: 600; }
  .cta:hover { background: var(--red); }
  main { max-width: 760px; margin: 0 auto; padding: 40px 16px 64px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.2; margin: 0 0 12px; letter-spacing: -0.02em; }
  h2 { font-size: 1.5rem; line-height: 1.3; margin: 2.2em 0 .6em; letter-spacing: -0.01em; }
  h3 { font-size: 1.2rem; margin: 1.8em 0 .5em; }
  img { max-width: 100%; height: auto; border-radius: 10px; }
  pre { background: var(--ink-deep); color: var(--cream); padding: 16px; border-radius: 10px; overflow-x: auto; font-size: .9rem; }
  code { font-family: ui-monospace, "Fira Code", Menlo, monospace; font-size: .9em; }
  :not(pre) > code { background: var(--cream); padding: 2px 6px; border-radius: 4px; }
  table { width: 100%; border-collapse: collapse; display: block; overflow-x: auto; font-size: .95rem; }
  th, td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; }
  th { background: var(--cream); }
  blockquote { border-left: 4px solid var(--green); margin: 1.5em 0; padding: .2em 1em; color: var(--muted); }
  .site-footer { border-top: 1px solid var(--line); padding: 24px 16px; text-align: center; color: var(--muted); font-size: .9rem; }
</style>
