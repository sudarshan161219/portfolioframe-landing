---
// Same fonts as the landing page (src/main.tsx)
import '@fontsource-variable/fraunces';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: object | object[];
}
const { title, description, image = 'https://portfolioframe.com/og-image.png', type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CWS = 'https://chromewebstore.google.com/detail/kgpdfalcolcdidglbdnfnelgihlocmkf?utm_source=blog';
const CUTOUT_CWS = 'https://chromewebstore.google.com/detail/bbabbmnpeiapnfikblfhdjkbodpgiolb?utm_source=blog';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0c0d" />
    <link rel="sitemap" href="/blog/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Portfolio Frame" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="wordmark" href="/">
          <span class="mark" aria-hidden="true"></span>
          <span>Portfolio Frame</span>
        </a>
        <nav class="rail" aria-label="Site">
          <a class="rail-link" href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a class="rail-link" href="/#editor">Features</a>
          <a class="rail-link" href="/#pricing">Pricing</a>
          <a class="rail-link" href="https://cutout.portfolioframe.com/">Cutout</a>
        </nav>
        <a class="nav-cta" href={CWS} rel="noopener">Add to Chrome</a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="brand-block">
          <a class="wordmark" href="/">
            <span class="mark mark-sm" aria-hidden="true"></span>
            <span>Portfolio Frame</span>
          </a>
          <p class="tagline">Screenshots, code and tweets turned into polished images. Everything runs locally in your browser.</p>
        </div>
        <div class="link-group">
          <p class="group-label">Product</p>
          <a href="/#editor">Editor</a>
          <a href="/#code">Code screenshots</a>
          <a href="/#mockups">Mockups</a>
          <a href="/#pricing">Pricing</a>
        </div>
        <div class="link-group">
          <p class="group-label">Free tools</p>
          <a href={CWS} rel="noopener">Portfolio Frame for Chrome</a>
          <a href="https://cutout.portfolioframe.com/">Cutout: background remover</a>
          <a href={CUTOUT_CWS} rel="noopener">Cutout for Chrome</a>
        </div>
        <div class="link-group">
          <p class="group-label">Read</p>
          <a href="/blog/">Blog</a>
          <a href="/vs/shots-so">Compare tools</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
      <div class="baseline">
        <span>© {year} Portfolio Frame</span>
        <span>Built by <a href="https://x.com/buildwithSud" rel="noopener">@buildwithSud</a></span>
      </div>
    </footer>
    <script is:inline>
      // Hide only images whose file is missing (e.g. a placeholder not uploaded yet). Real images always show.
      document.querySelectorAll('.prose img, .deck img').forEach(function (img) {
        function hide() { img.style.display = 'none'; }
        if (img.complete && img.naturalWidth === 0) hide();
        img.addEventListener('error', hide);
      });
    </script>
  </body>
</html>

<style is:global>
  /* Tokens copied from the landing page (src/styles/tokens.css) */
  :root {
    --cream: #f5f6f7;
    --paper: #e8eaed;
    --mint: #4ea8de;
    --red: #3a3d42;
    --sage: #7c828b;
    --ink: #000000;
    --pine: #18191b;
    --void: #0b0c0d;

    --bg: var(--void);
    --bg-elev: var(--pine);
    --bg-elev-2: color-mix(in srgb, var(--pine) 82%, black);
    --hairline: color-mix(in srgb, var(--cream) 12%, transparent);
    --hairline-strong: color-mix(in srgb, var(--cream) 22%, transparent);

    --text-primary: var(--cream);
    --text-muted: color-mix(in srgb, var(--cream) 62%, transparent);
    --text-faint: color-mix(in srgb, var(--cream) 40%, transparent);

    --font-display: 'Fraunces Variable', 'Fraunces', 'Iowan Old Style', serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --font-body: 'Inter', -apple-system, sans-serif;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --container: 1180px;
    --edge: clamp(20px, 5vw, 64px);
    --measure: 720px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
  }
  body {
    margin: 0; background: var(--bg); color: var(--text-primary);
    font-family: var(--font-body); font-size: 16px; line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  img { max-width: 100%; height: auto; }
  button { font-family: inherit; }
  :focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; }
  ::selection { background: var(--sage); color: var(--void); }


  /* ---------- Nav (matches landing Nav.module.css) ---------- */
  .nav { position: sticky; top: 0; z-index: 40; background: rgba(11, 12, 13, .86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--hairline); }
  .nav-inner { margin: 0 auto; padding: 16px var(--edge); display: flex; align-items: center; gap: 32px; justify-content: space-between; }
  .wordmark { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 560; font-size: 1.15rem; letter-spacing: .01em; text-decoration: none; color: var(--text-primary); flex-shrink: 0; }
  .mark { width: 18px; height: 18px; border: 1.5px solid var(--mint); border-radius: 4px; position: relative; flex: none; }
  .mark::after { content: ''; position: absolute; inset: 4px; border: 1.5px solid var(--sage); border-radius: 2px; }
  .mark-sm { width: 16px; height: 16px; }
  .rail { display: flex; gap: 4px; flex: 1; overflow-x: auto; scrollbar-width: none; }
  .rail::-webkit-scrollbar { display: none; }
  .rail-link { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; text-decoration: none; color: var(--text-muted); padding: 8px 12px; border-radius: var(--radius-sm); white-space: nowrap; transition: color .15s ease, background .15s ease; }
  .rail-link:hover, .rail-link[aria-current='page'] { color: var(--text-primary); background: rgba(245, 246, 247, .06); }
  .nav-cta { flex-shrink: 0; font-family: var(--font-mono); font-size: .78rem; letter-spacing: .03em; text-decoration: none; color: var(--void); background: var(--mint); padding: 10px 16px; border-radius: var(--radius-sm); font-weight: 600; transition: background .15s ease, transform .15s ease; }
  .nav-cta:hover { background: var(--sage); transform: translateY(-1px); }
  @media (max-width: 760px) { .rail { display: none; } .nav-inner { gap: 16px; } }

  /* ---------- Shared type helpers ---------- */
  main { min-height: 60vh; }
  .eyebrow { font-family: var(--font-mono); font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; color: var(--mint); margin: 0 0 16px; }
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { color: var(--text-primary); }

  /* ---------- Footer (matches landing Footer.module.css) ---------- */
  .footer { border-top: 1px solid var(--hairline); padding: 56px var(--edge) 28px; max-width: var(--container); margin: 72px auto 0; }
  .footer-inner { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; padding-bottom: 40px; }
  .footer .wordmark { font-size: 1.1rem; }
  .tagline { margin: 14px 0 0; max-width: 32ch; font-size: .86rem; line-height: 1.55; color: var(--text-muted); }
  .group-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-faint); margin: 0 0 14px; }
  .link-group { display: flex; flex-direction: column; gap: 10px; }
  .link-group a { font-size: .88rem; text-decoration: none; color: var(--text-muted); width: fit-content; }
  .link-group a:hover { color: var(--text-primary); }
  .baseline { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 20px; border-top: 1px solid var(--hairline); font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); }
  .baseline a { color: var(--text-faint); text-decoration: none; }
  .baseline a:hover { color: var(--text-primary); }
  @media (max-width: 900px) { .footer-inner { grid-template-columns: repeat(3, 1fr); } .brand-block { grid-column: 1 / -1; } }
  @media (max-width: 620px) { .footer-inner { grid-template-columns: 1fr; } .baseline { flex-direction: column; gap: 8px; } }
</style>
